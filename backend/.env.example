# ===================== 数据库配置 =====================
DATABASE_URL=sqlite:///./paper_writer.db
# 生产环境可使用 PostgreSQL：
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/paper_writer

# ===================== LLM 配置 =====================
# 可选：qwen（千问）/ openai / deepseek / zhipu
LLM_PROVIDER=qwen

# 千问（阿里云百炼 DashScope，OpenAI 兼容模式）—— 在这里填写你的 API Key
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# OpenAI 配置
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4

# DeepSeek 配置
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 智谱 AI 配置
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4

# LLM 通用参数
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=300

# ===================== 向量数据库配置 =====================
EMBEDDING_PROVIDER=qwen
VECTOR_DB_PATH=./data/chroma
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_BATCH_SIZE=10

# ===================== JWT 配置 =====================
SECRET_KEY=change-this-to-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===================== 应用配置 =====================
DEBUG=false